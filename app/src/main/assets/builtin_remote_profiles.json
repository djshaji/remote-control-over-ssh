{
  "profiles": [
    {
      "id": "desktop-navigation-volume",
      "name": "Desktop Navigation + Volume",
      "commands": {
        "DPAD_UP": "xdotool key Up",
        "DPAD_DOWN": "xdotool key Down",
        "DPAD_LEFT": "xdotool key Left",
        "DPAD_RIGHT": "xdotool key Right",
        "DPAD_SELECT": "xdotool key Return",
        "BTN_BACK": "xdotool key Escape",
        "BTN_HOME": "xdotool key Super_L",
        "SLIDER_1_STEP_0": "pactl set-sink-volume @DEFAULT_SINK@ 0%",
        "SLIDER_1_STEP_1": "pactl set-sink-volume @DEFAULT_SINK@ 10%",
