        "SLIDER_1_STEP_7": "pactl set-sink-volume @DEFAULT_SINK@ 70%",
        "SLIDER_1_STEP_8": "pactl set-sink-volume @DEFAULT_SINK@ 80%",
        "SLIDER_1_STEP_9": "pactl set-sink-volume @DEFAULT_SINK@ 90%",
        "SLIDER_1_STEP_10": "pactl set-sink-volume @DEFAULT_SINK@ 100%",
        "SLIDER_2_STEP_0": "pactl set-source-volume @DEFAULT_SOURCE@ 0%",
